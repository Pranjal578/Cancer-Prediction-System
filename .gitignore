# ==============================================================================
# Git Ignore Rules for Breast Cancer Prediction & Research Framework
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
develop-eggs/
eggs/
parts/
bin/
var/
sdist/
develop/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, Linting & Coverage Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/

# ------------------------------------------------------------------------------
# 2. Node.js, Frontend & Build Tools
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
.npm/

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Model Artefacts & Checkpoints (Recreatable via Pipeline Scripts)
# ------------------------------------------------------------------------------
# Legacy CDSS generated artifacts
cdss/artifacts/

# Research generated binary model checkpoints (large files >30MB)
# Recreate with: cd research && python run_experiments.py
research/artifacts/models/
*.joblib
*.ckpt
*.pt
*.pth
*.onnx

# ------------------------------------------------------------------------------
# 4. Data Protection Rules
# ------------------------------------------------------------------------------
# Keep only the versioned raw WDBC source files
cdss/data/raw/*
!cdss/data/raw/wdbc.data
!cdss/data/raw/wdbc.names

# ------------------------------------------------------------------------------
# 5. Environment Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.streamlit/secrets.toml
*.pem
*.key
secrets/

# ------------------------------------------------------------------------------
# 6. Logs, Databases & Runtime Files
# ------------------------------------------------------------------------------
*.log
*.pid
*.seed
*.pid.lock
*.db
*.sqlite3
cdss/logs/*.log
research/logs/*.log

# ------------------------------------------------------------------------------
# 7. IDE, Editor & OS Artefacts
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.ipynb_checkpoints/
